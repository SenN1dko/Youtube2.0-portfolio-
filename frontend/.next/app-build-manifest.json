      "static/chunks/main-app.js",
      "static/chunks/app/(public)/page.js"
    ],
    "/(public)/v/[publicId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public)/v/[publicId]/page.js"
    ],
    "/(public)/trending/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public)/trending/page.js"
    ],
